{
  "name": "gray-crown-v2-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:web": "npm run build:csharp && vite build",
    "build:launcher": "cargo build --release",
    "test": "node --test tests/*.test.mjs && cargo test",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "build:csharp": "node scripts/build-csharp.mjs",
    "generate:french-audio": "node scripts/generate-french-audio.mjs",
    "generate:english-audio": "node scripts/generate-english-audio.mjs",
    "test:csharp": "node scripts/test-csharp-reference.mjs",
    "test:browser": "node tests/browser-courses.mjs",
    "build:public": "node scripts/build-public.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.8",
    "@wasmer/sdk": "0.10.0",
    "katex": "^0.16.47"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "8.2.1"
  }
}
